.main-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

.bottom-panel {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 120px;
    background-color: rgba(0, 0, 0, 0.7);
    flex-direction: row;
    padding: 10px;
}

.stats-container {
    width: 200px;
    height: 100%;
    flex-direction: column;
}

.abilities-container {
    flex-grow: 1;
    height: 100%;
    flex-direction: row;
    margin-left: 20px;
}

.turn-container {
    width: 150px;
    height: 100%;
    border-radius: 10px;
    background-color: rgba(64, 0, 0, 0.5);
    margin-left: 20px;
    padding: 10px;
}

.label {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
}

.stat-label {
    color: #CCCCCC;
    font-size: 14px;
    margin-top: 10px;
}

.ability-button {
    width: 80px;
    height: 80px;
    margin: 5px;
    background-color: rgba(64, 64, 64, 0.7);
    border-width: 2px;
    border-color: #888888;
    border-radius: 10px;
}

.ability-button:hover {
    background-color: rgba(100, 100, 100, 0.7);
    border-color: white;
}

.ability-button:active {
    background-color: rgba(150, 150, 150, 0.7);
    border-color: yellow;
}

.ability-button-selected {
    border-color: yellow;
    background-color: rgba(100, 100, 64, 0.7);
}

.end-turn-button {
    position: absolute;
    right: 20px;
    bottom: 140px;
    width: 120px;
    height: 40px;
    background-color: rgba(200, 50, 50, 0.7);
    border-radius: 20px;
    border-width: 2px;
    border-color: #BB5555;
    color: white;
    -unity-font-style: bold;
    font-size: 16px;
}

.end-turn-button:hover {
    background-color: rgba(220, 70, 70, 0.7);
    border-color: white;
}

.end-turn-button:active {
    background-color: rgba(255, 100, 100, 0.7);
    border-color: yellow;
}
.tooltip-container {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.9);
    border-radius: 5px;
    padding: 10px;
    width: 250px;
    border-width: 1px;
    border-color: #CCCCCC;
}

.tooltip-title {
    color: #FFCC00;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.tooltip-description {
    color: white;
    font-size: 14px;
    margin-bottom: 8px;
}

.tooltip-stat {
    color: #AACCFF;
    font-size: 12px;
}

.ability-button-cooldown {
    color: #FF5555;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    width: 24px;
    height: 24px;
    position: absolute;
    top: 5px;
    right: 5px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 14px;
}

.ability-button-disabled {
    opacity: 0.5;
    background-color: rgba(30, 30, 30, 0.7);
}